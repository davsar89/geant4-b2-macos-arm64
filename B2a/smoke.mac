# Short run through all EM primaries: initialises every EM model (reads all EM data it needs).
#
/control/verbose 2
/run/initialize
#
/gun/particle gamma
/gun/energy 6 MeV
/run/beamOn 20
/gun/energy 50 keV
/run/beamOn 20
#
/gun/particle e-
/gun/energy 3 GeV
/run/beamOn 5
/gun/energy 1 MeV
/run/beamOn 20
#
/gun/particle e+
/gun/energy 200 MeV
/run/beamOn 20
